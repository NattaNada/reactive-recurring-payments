# Deployment env — copy to .env and fill in. NEVER commit .env or any key.
# Deployer key (EVM wallet). Used ONLY by the deploy scripts, never by the contracts.
PRIVATE_KEY=
# Who receives each recurring payment (destination chain, Base Sepolia).
BENEFICIARY=
# Fixed payment size, in wei of the destination chain's native currency (e.g. 10000000000000000 = 0.01 ETH).
PAYMENT_AMOUNT_WEI=10000000000000000
# Seconds between scheduled payments. 86400 = daily. 600 = 10 min (demo).
INTERVAL_SECONDS=86400
# Optional: REACT (Lasna) sent to the RSC at deployment to pre-fund it, in wei. 0 = fund later via depositTo().
FUND_REACT_WEI=0
# Optional: ETH (Base Sepolia) sent to the callback contract at deployment, in wei. 0 = fund later.
FUND_ETH_WEI=0
# Filled in after step 1 / step 2 of deployment (see README).
RSC_ADDRESS=
CALLBACK_ADDRESS=
# Optional top-up watch (see README). 0x0 = disabled.
WATCHED_TOKEN=
TOP_UP_THRESHOLD_WEI=0
# RPC endpoints (public defaults).
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
